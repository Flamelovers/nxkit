+def ycd_shaders(path, label):
+    """Propeller's YCD shaders.pak.yc: each .vert.bin/.frag.bin is an 8-byte
+    prefix, a 0x880-byte NVN control section, then its code area. The table
+    stores signed relative pointers in the high 32 bits of its 64-bit fields.
+    Only read the shader pack; other YCD packs are game assets, not shaders."""
+    out = []
+    with open(path, 'rb') as f:
+        f.seek(0, 2); end = f.tell()
+        f.seek(8); content = struct.unpack('<Q', f.read(8))[0]
+        if not 128 <= content <= end - 16: red(f'{label}: bad YCD content offset')
+        f.seek(content); desc = f.read(16)
+        count = struct.unpack_from('<q', desc)[0] >> 34
+        table = content + 8 + (struct.unpack_from('<q', desc, 8)[0] >> 32)
+        if not 0 < count < 100000 or not 0 <= table <= end - count * 32: red(f'{label}: bad YCD file table')
+        for i in range(count):
+            pos = table + i * 32; f.seek(pos); e = f.read(32)
+            n = struct.unpack_from('<q', e)[0] >> 32
+            name_at = pos + 8 + (struct.unpack_from('<q', e, 8)[0] >> 32)
+            size = struct.unpack_from('<I', e, 16)[0]
+            data_at = pos + 24 + (struct.unpack_from('<q', e, 24)[0] >> 32)
+            if not 0 < n < 4096 or not 0 <= name_at <= end - n: red(f'{label}: bad YCD name at entry {i}')
+            f.seek(name_at); name = f.read(n).decode('utf-8')
+            st = 'vs' if name.endswith('.vert.bin') else 'ps' if name.endswith('.frag.bin') else None
+            if not st: continue
+            if size < 8 + 0x880 + 0x30 or not 0 <= data_at <= end - size: red(f'{label}/{name}: bad shader data range')
+            f.seek(data_at); data = f.read(size)
+            ctl, code = data[8:8 + 0x880], data[8 + 0x880:]
+            why = check(label, st, ctl, code)
+            if why: red(f'{label}/{name}: {why}')
+            actual = glslc_stage(ctl, code)
+            if actual != st: red(f'{label}/{name}: stage {actual}, expected {st}')
+            out.append((f'{label}/{name}', st, ctl, code))
+    return out
+
