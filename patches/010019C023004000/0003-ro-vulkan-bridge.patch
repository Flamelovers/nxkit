diff --git a/dm/host/hle.c b/dm/host/hle.c
index 672c16a3..95ea7da9 100644
--- a/dm/host/hle.c
+++ b/dm/host/hle.c
@@ -80,6 +80,7 @@ uint64_t resolve_import(module_t *m, const char *name) {
 
 // The host implements this import (the swhle table), without allocating a stub for it
 int hle_implements(const char *name) { return hle_find(name) != NULL; }
+void *hle_symbol(const char *name) { const hle_ent *e = hle_find(name); return e ? e->fn : NULL; }
 
 void stubs_report(void) { LOG("stubs=%u", g_nstub); }
 
